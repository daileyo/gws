#!/bin/bash
# Pre-push hook: Run linting and tests before pushing
# Install with: git config core.hooksPath .githooks
# Or run: make setup-hooks

set -e

echo "🔍 Running pre-push checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Add Go bin directories to PATH
export PATH="$PATH:$(go env GOPATH)/bin:$HOME/go/bin:/usr/local/go/bin"

# Check if golangci-lint is installed
if ! command -v golangci-lint &> /dev/null; then
    echo -e "${YELLOW}⚠️  golangci-lint not installed. Installing...${NC}"
    go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
fi

# Run go vet
echo "📋 Running go vet..."
if ! go vet ./...; then
    echo -e "${RED}❌ go vet failed${NC}"
    exit 1
fi
echo -e "${GREEN}✓ go vet passed${NC}"

# Run linting
echo "📋 Running golangci-lint..."
if ! golangci-lint run --timeout=5m; then
    echo -e "${RED}❌ Linting failed${NC}"
    echo ""
    echo "Fix the issues above before pushing."
    echo "You can run 'make lint' to see all issues."
    exit 1
fi
echo -e "${GREEN}✓ Linting passed${NC}"

# Run tests
echo "🧪 Running tests..."
if ! go test -race ./...; then
    echo -e "${RED}❌ Tests failed${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Tests passed${NC}"

echo ""
echo -e "${GREEN}✅ All pre-push checks passed!${NC}"
